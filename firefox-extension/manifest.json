{
    "manifest_version": 2,
    "name": "Browser Control MCP (UNOFFICIAL FORK)",
    "version": "1.5.2.2",
    "description": "UNOFFICIAL FORK - adds tab group management (list, add, ungroup, rename, move). Lets a local MCP server control the browser.",
    "permissions": [
        "tabs",
        "tabGroups",
        "history",
        "storage",
        "activeTab"
    ],
    "optional_permissions": [
        "*://*/*",
        "find"
    ],
    "background": {
        "scripts": [
            "dist/background.js"
        ]
    },
    "browser_action": {
        "default_icon": "assets/screenshot.svg",
        "default_title": "Browser Control MCP: allow a screenshot of this tab"
    },
    "options_ui": {
        "page": "options.html"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "browser-control-mcp@pythagorasdesaster",
            "strict_min_version": "139.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    }
}
